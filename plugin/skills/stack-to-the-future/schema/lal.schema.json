{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saishashank-a/stack-to-the-future/schema/lal.schema.json",
  "title": "Sir Lines-a-Lot scene (.lal) v0.1",
  "type": "object",
  "required": ["lal_version", "title", "generator", "layers", "frames", "nodes", "connectors", "callouts", "legends"],
  "properties": {
    "lal_version": { "const": "0.1" },
    "title": { "type": "string" },
    "generator": { "type": "string" },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "opacity"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["overview", "plate"] },
          "title": { "type": "string" },
          "x": { "type": "number" }, "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "frame", "layer", "shape", "x", "y", "width", "height", "label", "sublabels", "style", "link"],
        "properties": {
          "id": { "type": "string" },
          "frame": { "type": "string" },
          "layer": { "type": "string" },
          "shape": { "enum": ["rect", "pill", "diamond", "note", "band"] },
          "x": { "type": "number" }, "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 },
          "label": { "type": "string" },
          "caption": { "type": "string" },
          "sublabels": { "type": "array", "items": { "type": "string" } },
          "style": { "$ref": "#/$defs/nodeStyle" },
          "link": { "type": ["string", "null"] },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "frame", "layer", "from", "to", "points", "style"],
        "properties": {
          "id": { "type": "string" },
          "frame": { "type": "string" },
          "layer": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "label": { "type": "string" },
          "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
          "style": {
            "type": "object",
            "required": ["stroke", "color", "width", "arrow"],
            "properties": {
              "stroke": { "$ref": "#/$defs/stroke" },
              "color": { "$ref": "#/$defs/color" },
              "width": { "type": "number", "exclusiveMinimum": 0 },
              "arrow": { "enum": ["end", "none"] }
            }
          },
          "group": { "type": ["string", "null"] },
          "source": { "$ref": "#/$defs/source" }
        }
      }
    },
    "callouts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "frame", "layer", "target", "kind", "text", "x", "y", "width", "height"],
        "properties": {
          "id": { "type": "string" },
          "frame": { "type": "string" },
          "layer": { "type": "string" },
          "target": { "type": ["string", "null"] },
          "kind": { "type": "string" },
          "text": { "type": "string" },
          "x": { "type": "number" }, "y": { "type": "number" },
          "width": { "type": "number", "exclusiveMinimum": 0 }, "height": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "legends": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["frame", "entries"],
        "properties": {
          "frame": { "type": "string" },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "color"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "detail": { "type": "string" },
                "color": { "$ref": "#/$defs/color" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "stroke": { "enum": ["solid", "dashed", "dotted"] },
    "nodeStyle": {
      "type": "object",
      "required": ["stroke", "color", "fill"],
      "properties": {
        "stroke": { "$ref": "#/$defs/stroke" },
        "color": { "$ref": "#/$defs/color" },
        "fill": { "anyOf": [{ "$ref": "#/$defs/color" }, { "type": "null" }] }
      }
    },
    "source": {
      "type": "object",
      "required": ["kind", "id"],
      "properties": { "kind": { "type": "string" }, "id": { "type": "string" } }
    }
  }
}
