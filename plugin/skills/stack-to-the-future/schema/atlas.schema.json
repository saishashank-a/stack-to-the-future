{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/saishashank-a/stack-to-the-future/schema/atlas.schema.json",
  "title": "Stack to the Future atlas",
  "type": "object",
  "required": [
    "atlas_version",
    "project",
    "modules",
    "workflows",
    "files",
    "cards",
    "shared_systems",
    "foundation",
    "flags"
  ],
  "additionalProperties": false,
  "properties": {
    "atlas_version": {
      "const": "0.1"
    },
    "project": {
      "type": "object",
      "required": [
        "name",
        "generated_at",
        "scanner_version",
        "languages"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "scanner_version": {
          "type": "string"
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "frameworks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "summary",
          "workflows",
          "files",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "drawn": {
            "type": "boolean",
            "default": true,
            "description": "false = scanned but not yet drafted (large repos); shown greyed on the overview."
          },
          "workflows": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            }
          },
          "entry_points": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/entryPoint"
            }
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "links": {
      "description": "Cross-module handoffs for the full-body overview.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_stage",
          "to_stage",
          "label",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "from_stage": {
            "$ref": "#/$defs/slug"
          },
          "to_stage": {
            "$ref": "#/$defs/slug"
          },
          "label": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "module",
          "name",
          "summary",
          "stages",
          "paths",
          "variants"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "module": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/stage"
            },
            "minItems": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path_edge"
            }
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/variant"
            }
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "language",
          "layer"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "language": {
            "type": "string"
          },
          "loc": {
            "type": "integer",
            "minimum": 0
          },
          "module": {
            "$ref": "#/$defs/slug"
          },
          "layer": {
            "enum": [
              "business",
              "foundation",
              "ignored"
            ]
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file",
          "role",
          "stages",
          "contribution",
          "receives",
          "hands_off",
          "if_removed",
          "evidence",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "$ref": "#/$defs/path"
          },
          "role": {
            "type": "string",
            "maxLength": 140,
            "description": "One line, plain language."
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "contribution": {
            "$ref": "#/$defs/contribution"
          },
          "receives": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/handoff"
            }
          },
          "hands_off": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/handoff"
            }
          },
          "if_removed": {
            "type": "string",
            "description": "What breaks if this file is gone."
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "File hash the card was written against; mismatch = stale."
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "shared_systems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "files",
          "used_by_stages",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            }
          },
          "used_by_stages": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/slug"
            }
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          },
          "provenance": {
            "$ref": "#/$defs/provenance"
          },
          "locked": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "foundation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "group",
          "files"
        ],
        "additionalProperties": false,
        "properties": {
          "group": {
            "enum": [
              "configuration",
              "database_setup",
              "secrets_loading",
              "dependencies",
              "wiring",
              "other"
            ]
          },
          "label": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            }
          }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "message",
          "target",
          "evidence"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/slug"
          },
          "kind": {
            "enum": [
              "stub",
              "todo",
              "not_implemented",
              "missing_transition",
              "dead_end",
              "unreachable",
              "stale_override"
            ]
          },
          "message": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "stage",
                  "path",
                  "file",
                  "workflow",
                  "module",
                  "variant",
                  "shared_system",
                  "link"
                ]
              },
              "id": {
                "type": "string",
                "description": "A link's id is '<from_stage>-><to_stage>'; a card is targeted by its file."
              }
            }
          },
          "evidence": {
            "$ref": "#/$defs/evidenceList"
          }
        }
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-/][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\\\]+$",
      "description": "Repo-relative POSIX path."
    },
    "provenance": {
      "enum": [
        "scan",
        "claude",
        "human"
      ]
    },
    "contribution": {
      "enum": [
        "owner",
        "helper",
        "shared_system",
        "foundation"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "default": "complete"
    },
    "evidence": {
      "type": "object",
      "required": [
        "path",
        "start_line",
        "end_line"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "description": "Must exist in scan.json symbol table."
        }
      }
    },
    "evidenceList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "entryPoint": {
      "type": "object",
      "required": [
        "kind",
        "label",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "api_route",
            "ui_page",
            "cli_command",
            "background_job",
            "event_handler",
            "scheduled_job"
          ]
        },
        "label": {
          "type": "string",
          "description": "e.g. 'POST /leave-requests' or 'Leave form page'."
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        }
      }
    },
    "handoff": {
      "type": "object",
      "required": [
        "what"
      ],
      "additionalProperties": false,
      "properties": {
        "what": {
          "type": "string",
          "description": "Plain language, e.g. 'a submitted leave request'."
        },
        "from_or_to": {
          "type": "string",
          "description": "File path, stage id, or outside party ('the employee', 'email inbox')."
        }
      }
    },
    "stageFile": {
      "type": "object",
      "required": [
        "file",
        "contribution"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/path"
        },
        "contribution": {
          "$ref": "#/$defs/contribution"
        },
        "label": {
          "type": "string",
          "description": "The 'bone label' shown on the plate, e.g. 'routes/leave.py:submit'."
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "kind",
        "files",
        "evidence",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "maxLength": 60,
          "description": "Business verb phrase: 'Manager reviews request'."
        },
        "description": {
          "type": "string"
        },
        "actor": {
          "type": "string",
          "description": "Who does this: 'Employee', 'Manager', 'System'."
        },
        "kind": {
          "enum": [
            "start",
            "step",
            "decision",
            "end"
          ]
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stageFile"
          }
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "locked": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "path_edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "from": {
          "$ref": "#/$defs/slug"
        },
        "to": {
          "$ref": "#/$defs/slug"
        },
        "label": {
          "type": "string",
          "description": "e.g. 'approved', 'over 5 days'."
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "description": "Empty = shared trunk travelled by every variant."
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "locked": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "name",
        "condition",
        "route",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "description": "e.g. 'Self-approval'."
        },
        "condition": {
          "type": "string",
          "description": "Plain language: 'when the requester is also the approver'."
        },
        "route": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "minItems": 2,
          "description": "Ordered stage ids; must start and end on shared stages so branches merge."
        },
        "evidence": {
          "$ref": "#/$defs/evidenceList"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "locked": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
